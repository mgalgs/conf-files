# clip2remote destinations -- copy this to ~/.config/clip2remote/destinations
# and edit it with your real hosts. That path is NOT tracked by this repo, so
# your private hostnames stay out of version control.
#
# One destination per line:  <label>  <ssh-target>
#   <label>       shown in the panel menu
#   <ssh-target>  a host, optionally host:/dir (clip2remote.sh defaults the
#                 directory to /tmp)
#
# Blank lines and lines starting with # are ignored. A line with a single
# field uses it as both the label and the target.

laptop   host1.example.com
server   host2.example.com:/home/me/shots
